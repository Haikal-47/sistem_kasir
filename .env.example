# ── REQUIRED: Neon PostgreSQL connection string ──────────────────────────────
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── REQUIRED: Port for the local/dev server ───────────────────────────────────
PORT=3001

# ── REQUIRED: Secure random secret for JWT signing ───────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be set — server will REFUSE TO START if this is missing.
AUTH_SECRET=

# ── OPTIONAL: Allowed CORS origins (comma-separated) ─────────────────────────
# Example: ALLOWED_ORIGINS=https://arfa-fashion.vercel.app,https://my-custom-domain.com
ALLOWED_ORIGINS=
